                    .col-lg-6
                        .text-center.h-100.project
                            .d-flex.h-100
                                .project-text.w-100.my-auto.text-center.text-lg-left
                                    h4.text-white Pi Hole - Ad Blocker
                                    p.mb-0.text-white-50
                                        | The Pi Hole project adds a new layer of security to one's home network to block unwanted ads and metrics across the network. The Pi Hole runs on a Raspberry Pi III.
                                    a.btn.btn-primary Learn more - page in progress
                                    //a.btn.btn-primary(href='pihole.html') Learn more - page in progress
                // Project Four Row
                .row.gx-0.justify-content-center
                    .col-lg-6
                        img.img-fluid(src='assets/img/homeassistant.png', alt='HomeAssistant')
                    .col-lg-6.order-lg-first
                        .text-center.h-100.project
                            .d-flex.h-100
                                .project-text.w-100.my-auto.text-center.text-lg-right
