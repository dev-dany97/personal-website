doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title My Projects

        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        // Font Awesome icons (free version)
        script(src='https://use.fontawesome.com/releases/v6.5.1/js/all.js', crossorigin='anonymous')

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Varela+Round', rel='stylesheet')
        link(href='https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i', rel='stylesheet')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body#page-top

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.navbar-light.fixed-top
            .container.px-4.px-lg-5
                a.navbar-brand(href='index.html#page-top') Modeste
                button.navbar-toggler.navbar-toggler-right(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    i.fas.fa-bars
                #navbarResponsive.collapse.navbar-collapse
                    ul.navbar-nav.ms-auto
                        li.nav-item
                            a.nav-link(href='index.html#about') About me
                        li.nav-item
                            a.nav-link(href='projects.html#projects') My Projects
                        li.nav-item
                            a.nav-link(href='setup.html') My Setup
                        li.nav-item
                            a.nav-link(href='travelstories.html') Travelstories
                        li.nav-item
                            a.nav-link(href='finance.html#finance') Finance
                        li.nav-item
                            a.nav-link(href='index.html#signup') Contact

        // Masthead
        header.projectdetail

        // Overview
        section#about.overview-section-project
            .container.px-4.px-lg-5.d-flex.h-100.align-items-center.justify-content-center
                .d-flex.justify-content-center
                    .text-center
                        h1.mx-auto.my-0 Magic Mirror
                        h4.text-white-50.mx-auto.mt-2.mb-5 The Magic Mirror project is a very extensive but also a flexible project with endless possibilities. I use the project to be informed about important dates, events and news and to start the day with nice sayings.

            .container.px-4.px-lg-5
                .row.gx-0.mb-4.mb-lg-5.justify-content-center
                    img.img-fluid.mb-3.mb-lg-0(src='assets/img/magic-mirror.jpg', alt='Magic-Mirror', style="max-width: 50%")


        // Contact
        section.contact-section.bg-black
            .container.px-4.px-lg-5
                .row.gx-4.gx-lg-5
                    .col-md-4.mb-3.mb-md-0
                        .card.py-4.h-100
                            .card-body.text-center
                                i.fas.fa-map-marked-alt.text-primary.mb-2
                                h4.text-uppercase.m-0 Address
                                hr.my-4.mx-auto
                                .small.text-black-50 Regensburg, Germany
                    .col-md-4.mb-3.mb-md-0
                        .card.py-4.h-100
                            .card-body.text-center
                                i.fas.fa-envelope.text-primary.mb-2
                                h4.text-uppercase.m-0 Email
                                hr.my-4.mx-auto
                                .small.text-black-50
                                    a(href='mailto:kontakt@d-mohles.de') kontakt@d-mohles.de
                    .col-md-4.mb-3.mb-md-0
                        .card.py-4.h-100
                            .card-body.text-center
                                i.fas.fa-fingerprint.text-primary.mb-2
                                h4.text-uppercase.m-0 Privacy
                                hr.my-4.mx-auto
                                .small.text-black-50
                                a.nav-link(href='impressum.html') Impressum
                .social.d-flex.justify-content-center
                    a.mx-2(href='https://twitter.com/Daniel69119111')
                        i.fab.fa-x-twitter
                    a.mx-2(href='https://www.facebook.com/daniel.mohles.5')
                        i.fab.fa-facebook-f
                    a.mx-2(href='https://instagram.com/d.mohles')
                        i.fab.fa-instagram
                    a.mx-2(href='https://www.xing.com/profile/Daniel_Mohles')
                        i.fab.fa-xing
                    a.mx-2(href='https://linkedin.com/in/daniel-mohles')
                        i.fab.fa-linkedin
                    a.mx-2(href='https://music.apple.com/profile/dany_mohles')
                        i.fab.fa-itunes-note

        // Footer
        footer.footer.bg-black.small.text-center.text-white-50
            .container.px-4.px-lg-5
                | Copyright &copy; 2024 Daniel Mohles. All Rights Reserved.

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='js/scripts.js')
