# Cookieless analytics with Umami. Empty = no analytics.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Base URL of the CDN that serves the large videos, without a trailing slash.
# Empty = videos are loaded from public/videos.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Server only: read-only Binance key for the crypto portfolio on /finance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Server only: morning briefing on /finance
ANTHROPIC_API_KEY=

# Server only: Valorant profile on /setup
HENRIKDEV_API_KEY=

# Formspree form for the contact page
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Riot ID shown on the Valorant card
VALORANT_RIOT_NAME=
VALORANT_RIOT_TAG=

# Origins that may embed the site in an iframe, space-separated
FRAME_ANCESTORS=
