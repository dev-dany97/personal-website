# Kopieren nach .env.local und ausfüllen. Alles kann leer bleiben:
# die betroffenen Bereiche zeigen dann einen Hinweis statt Daten.

# --- Wird beim Build in den Browser-Code eingebaut (nichts Geheimes!) ---
# Cookielose Statistik mit Umami. Leer lassen = keine Statistik.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Basis-URL eines CDN für große Videos, ohne Slash am Ende.
# Leer lassen = Videos aus public/videos.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Formspree-Formular für die Kontaktseite (https://formspree.io)
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# --- Nur auf dem Server, nie im Browser-Code ---
# Finance-Seite: Binance-Portfolio (nur einen Read-only-Schlüssel verwenden!)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Finance-Briefing über die Claude-API
ANTHROPIC_API_KEY=
# Setup-Seite: Valorant-Profil über die HenrikDev-API
HENRIKDEV_API_KEY=
VALORANT_RIOT_NAME=
VALORANT_RIOT_TAG=
# Weitere Origins, die die Seite per iframe einbetten dürfen (Leerzeichen-getrennt)
FRAME_ANCESTORS=
