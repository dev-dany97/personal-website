{
    "title": "Website",
    "name": "my-website",
    "version": "7.0.4",
    "scripts": {
        "build": "npm run clean && npm run build:pug && npm run build:scss && npm run build:scripts && npm run build:assets",
        "build:assets": "node scripts/build-assets.js",
        "build:pug": "node scripts/build-pug.js",
        "build:scripts": "node scripts/build-scripts.js",
        "build:scss": "node scripts/build-scss.js",
        "clean": "node scripts/clean.js",
        "start": "npm run build && node scripts/start.js",
        "start:debug": "npm run build && node scripts/start-debug.js"
    },
    "description": "My own website based on Bootstrap.",
    "keywords": [
        "css",
        "sass",
        "html",
        "responsive",
        "theme",
        "template"
    ],
    "homepage": "https://d-mohles.de/",
    "bugs": {
        "url": "https://github.com/dev-dany97/personal-website/issues"
    },
    "license": "MIT",
    "author": "Daniel Mohles",
    "repository": {
        "type": "git",
        "url": "https://github.com/dev-dany97/personal-website"
    },
    "dependencies": {
        "bootstrap": "5.1.3",
        "startbootstrap-grayscale": "^7.0.4"
    },
    "devDependencies": {
        "autoprefixer": "10.3.7",
        "browser-sync": "^2.27.7",
        "chokidar": "3.5.2",
        "concurrently": "6.3.0",
        "postcss": "8.3.9",
        "prettier": "2.4.1",
        "pug": "3.0.2",
        "sass": "1.43.2",
        "shelljs": "^0.8.5",
        "upath": "2.0.1"
    }
}
