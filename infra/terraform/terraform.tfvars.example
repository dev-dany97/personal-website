aws_region                = "eu-central-1"
domain_name               = "example.com"
www_domain_name           = "www.example.com"
site_bucket_name          = "www.example.com"
hosted_zone_id            = "REPLACE_WITH_ROUTE53_HOSTED_ZONE_ID"
cloudtrail_log_bucket_name = "replace-with-globally-unique-cloudtrail-log-bucket"
cloudfront_price_class     = "PriceClass_100"

# Prefer an empty origin path and deploy site/ to the bucket root.
# Use "/<PREFIX>" only during a temporary migration.
origin_path = ""
